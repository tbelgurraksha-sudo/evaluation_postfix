#include <stdio.h>
#include <conio.h>
#include <string.h>
#include <math.h>

#define STACK_SIZE 50

void push(int item, int *top, int s[])
{
    if (*top == STACK_SIZE - 1)
    {
        printf("Stack overflow\n");
        return;
    }

    *top = *top + 1;
    s[*top] = item;
}

int pop(int *top, int s[])
{
    int item;

    if (*top == -1)
        return -1;

    item = s[*top];
    *top = *top - 1;

    return item;
}

void main()
{
    int result;
    char postfix[50];

    clrscr();

    printf("Enter postfix expression\n");
    scanf("%s", postfix);

    result = evaluate(postfix);

    printf("The result is %d\n", result);

    getch();
}

int evaluate(char postfix[50])
{
    int top = -1;
    int s[STACK_SIZE];
    int n, i;
    char symbol;
    int op1, op2, res;

    n = strlen(postfix);

    for (i = 0; i < n; i++)
    {
        symbol = postfix[i];

        switch (symbol)
        {
            case '+':
                op2 = pop(&top, s);
                op1 = pop(&top, s);
                res = op1 + op2;
                push(res, &top, s);
                break;

            case '-':
                op2 = pop(&top, s);
                op1 = pop(&top, s);
                res = op1 - op2;
                push(res, &top, s);
                break;

            case '*':
                op2 = pop(&top, s);
                op1 = pop(&top, s);
                res = op1 * op2;
                push(res, &top, s);
                break;

            case '/':
                op2 = pop(&top, s);
                op1 = pop(&top, s);
                res = op1 / op2;
                push(res, &top, s);
                break;

            case '^':
                op2 = pop(&top, s);
                op1 = pop(&top, s);
                res = (int)pow((double)op1, (double)op2);
                push(res, &top, s);
                break;

            default:
                push(symbol - '0', &top, s);
                break;
        }
    }

    return pop(&top, s);
}
